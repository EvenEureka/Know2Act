#!/bin/bash
#$ -q gpu
#$ -l gpu_card=1
#$ -pe smp 8
#$ -j y
#$ -o /path/to/Know2Act/logs/$JOB_NAME.$JOB_ID.log
# Mechanism measurements (PREREG §5) on held-out trajectories.
# usage: qsub -N meas_B -v NAME=B,MODEL=/path,REF=/path/base,GRAD=1 scripts/jobs/measure.sge
set -euo pipefail
source /path/to/Know2Act/scripts/env.sh
cd $ROOT
if [ ! -f "$MODEL/config.json" ]; then echo "SKIP: model missing ($MODEL); upstream run did not finish"; exit 0; fi
# failure mail: script errors (e.g. OOM) are not SGE "aborts", so -m a alone misses them
trap 'rc=$?; if [ $rc -ne 0 ] && [ -n "${MAILTO:-}" ]; then tail -40 "$SGE_STDOUT_PATH" | mail -s "[AgenticRL_CV] $JOB_NAME FAILED rc=$rc" "$MAILTO"; fi' EXIT
mkdir -p results/measure
$PY scripts/measure.py --model $MODEL ${REF:+--ref $REF} --data ${DATA:-data/sft/heldout.jsonl} \
  --out results/measure/$NAME.json --limit ${LIMIT:-300} $([[ ${GRAD:-0} == 1 ]] && echo --grad)
echo MEASURE_DONE
