#!/bin/bash
#$ -q gpu
#$ -l gpu_card=1
#$ -pe smp 8
#$ -j y
#$ -o /path/to/Know2Act/logs/$JOB_NAME.$JOB_ID.log
# Why does observation supervision not change the action policy? SFT-stage diagnostics (2026-10-07).
#   MODE=kl         D1: action-token KL between SFT arms (B, C085, D vs A) on held-out trajectories
#   MODE=obs        D2: observation CE by outcome type and part (base, A, B, D; held-out and train)
#   MODE=gradtrain  gradient cos/ratio and CE on *training* trajectories (A, B), vs the held-out ones
#   MODE=followup_a action KL of the Addendum-6 arms D_obs, E1 (vs base) and B, E1, E2 (vs A, e2 context)
#   MODE=followup_b outcome-line CE on unseen DBs in the e1 slot (A, B, E1) and the e2 slot (A, B, E2)
# usage: qsub -N diag_kl -v MODE=kl -v MAILTO=... scripts/jobs/diag.sge
set -euo pipefail
source /path/to/Know2Act/scripts/env.sh
cd $ROOT
trap 'rc=$?; if [ $rc -ne 0 ] && [ -n "${MAILTO:-}" ]; then tail -40 "$SGE_STDOUT_PATH" | mail -s "[AgenticRL_CV] $JOB_NAME FAILED rc=$rc" "$MAILTO"; fi' EXIT
BASE=$(snap Qwen/Qwen3-4B)
S=results/sft
A=$S/sft_A_1507464/model; B=$S/sft_B_1507462/model; C=$S/sft_C085_1507468/model; D=$S/sft_D_1507466/model
mkdir -p results/measure
case $MODE in
  kl)
    for X in B:$B C085:$C D:$D; do
      $PY scripts/measure.py --model ${X#*:} --ref $A --data data/sft/heldout.jsonl --limit 300 \
        --out results/measure/diag_kl_${X%%:*}_vs_A.json
    done ;;
  obs)
    $PY scripts/obs_breakdown.py --tokenizer $BASE --models base=$BASE A=$A B=$B D=$D \
      --data heldout=data/sft/heldout.jsonl train=data/sft/train.jsonl --limit 300 \
      --out results/measure/diag_obs_breakdown.json ;;
  gradtrain)
    for X in A:$A B:$B; do
      $PY scripts/measure.py --model ${X#*:} --data data/sft/train.jsonl --limit 300 --grad \
        --out results/measure/diag_train_${X%%:*}.json
    done ;;
  followup_a)  # action movement of the Addendum-6 arms (paths from the submit script: DOBS, E1, E2)
    for X in Dobs:$DOBS E1:$E1; do
      [ -f ${X#*:}/config.json ] || { echo "SKIP ${X%%:*}: model missing"; continue; }
      $PY scripts/measure.py --model ${X#*:} --ref $BASE --data data/sft/heldout.jsonl --limit 300 \
        --out results/measure/sft_${X%%:*}.json
    done
    # noise floor for D1: A trained with another data order (seed 1), added 2026-10-07 after seeing D1
    AS1=$(ls -d results/sft/sft_Aseed1_*/model 2>/dev/null | head -1)
    if [ -n "$AS1" ] && [ -f $AS1/config.json ]; then
      $PY scripts/measure.py --model $AS1 --ref $A --data data/sft/heldout.jsonl --limit 300 \
        --out results/measure/diag_kl_Aseed1_vs_A.json
    fi
    # same context for every model (held-out with the outcome lines, which are not scored)
    for X in B:$B E1:$E1 E2:$E2; do
      [ -f ${X#*:}/config.json ] || { echo "SKIP ${X%%:*}: model missing"; continue; }
      $PY scripts/measure.py --model ${X#*:} --ref $A --data data/sft/heldout_e2_ctx.jsonl --limit 300 \
        --out results/measure/diag_e2ctx_${X%%:*}_vs_A.json
    done ;;
  followup_b)  # outcome-line CE on unseen DBs: after the call (e1 slot) and before it (e2 slot)
    for X in A:$A B:$B E1:$E1; do
      [ -f ${X#*:}/config.json ] || { echo "SKIP ${X%%:*}: model missing"; continue; }
      $PY scripts/measure.py --model ${X#*:} --data data/sft/heldout_e1.jsonl --limit 300 \
        --out results/measure/diag_label_e1slot_${X%%:*}.json
    done
    for X in A:$A B:$B E2:$E2; do
      [ -f ${X#*:}/config.json ] || { echo "SKIP ${X%%:*}: model missing"; continue; }
      $PY scripts/measure.py --model ${X#*:} --data data/sft/heldout_e2_label.jsonl --limit 300 \
        --out results/measure/diag_label_e2slot_${X%%:*}.json
    done
    ;;
  aseed1)  # review 2026-10-08: data-order noise floor in the right contexts (KL to base; e2 context)
    AS1=results/sft/sft_Aseed1_1514021/model
    $PY scripts/measure.py --model $AS1 --ref $BASE --data data/sft/heldout.jsonl --limit 300 \
      --out results/measure/sft_Aseed1.json
    $PY scripts/measure.py --model $AS1 --ref $A --data data/sft/heldout_e2_ctx.jsonl --limit 300 \
      --out results/measure/diag_e2ctx_Aseed1_vs_A.json ;;
  *) echo "unknown MODE=$MODE"; exit 2 ;;
esac
echo DIAG_DONE
