#!/bin/bash
#$ -q long
#$ -pe smp 8
#$ -j y
#$ -o /path/to/Know2Act/logs/$JOB_NAME.$JOB_ID.log
# CPU-only E3 readouts (scripts/e3_readouts.py) for one eval run; mails the numbers.
# usage: qsub -N e3r_pre_E3 -hold_jid <eval job> -v NAME=pre_E3 -v DIR=results/eval/pre_E3 -v MAILTO=... scripts/jobs/e3_readouts.sge
set -euo pipefail
source /path/to/Know2Act/scripts/env.sh
cd $ROOT
if ! ls $DIR/*.jsonl >/dev/null 2>&1; then echo "SKIP: no rollouts in $DIR"; exit 0; fi
$PY scripts/e3_readouts.py --procs 8 --runs $NAME=$DIR --out results/e3_readouts_$NAME.json | tee /dev/stderr \
  | mail -s "[AgenticRL_CV] E3 readouts: $NAME" "$MAILTO"
