#!/bin/bash
# 2026-10-10: node restriction lifted by the user; any node with free GPUs. NGPU (default 2) = shards per dataset.
#$ -q gpu
#$ -l gpu_card=1
#$ -pe smp 16
#$ -j y
#$ -o /path/to/Know2Act/logs/$JOB_NAME.$JOB_ID.log
# Decision-point intervention on the Contract arm (PREREG Addendum 10): replace / remove / correct the
# contract at the first decision point of the Contract SFT and GRPO models' own rollouts and re-sample
# the continuation. Stage 1 is a smoke run on 12 Spider questions whose read-outs must pass sanity
# assertions; stage 2 runs both models on both datasets (one shard per GPU); stage 3 analyses and mails.
# usage: qsub -N contract_int -hold_jid <job> scripts/jobs/contract_intervention.sge
set -euo pipefail
source /path/to/Know2Act/scripts/env.sh
export PYTHONHASHSEED=0
cd $ROOT
trap 'rc=$?; if [ $rc -ne 0 ] && [ -n "${MAILTO:-}" ]; then tail -40 "$SGE_STDOUT_PATH" | mail -s "[AgenticRL_CV] $JOB_NAME FAILED rc=$rc" "$MAILTO"; fi' EXIT
mkdir -p $LOCAL/omnisql && rsync -a $ROOT/data/omnisql/data/ $LOCAL/omnisql/data/
OUT=$ROOT/results/intervention; mkdir -p $OUT/smoke
SFT=$ROOT/results/sft/sft_E3_1516400/model
GRPO=$ROOT/results/grpo/grpo_E3_s1_1516402/model
COMMON="--db_path $LOCAL/omnisql/data --tp 1 --gpu_mem 0.88 --seed ${SEED:-0} --enable_thinking false --dp ${DP:-first}"

# stage 1: smoke on one GPU
CUDA_VISIBLE_DEVICES=0 $PY scripts/contract_intervention.py --model $SFT --rollouts results/eval/pre_E3 \
  --data data/v1/spider_dev.parquet --ds spider_dev --out $OUT/smoke/spider_dev.shard0.jsonl \
  --samples 2 --k 2 --limit 12 $COMMON > $ROOT/logs/contract_int_smoke.$JOB_ID.log 2>&1
$PY scripts/contract_intervention_analysis.py --runs smoke=$OUT/smoke --out $OUT/smoke/readouts.json --smoke
echo SMOKE_OK

# stage 2: both models x both datasets, one shard per GPU (NGPU GPUs)
NGPU=${NGPU:-2}
for SPEC in "sftE3:$SFT:results/eval/pre_E3" "grpoE3:$GRPO:results/eval/grpo_E3_s1_1516402"; do
  IFS=: read NAME MODEL ROLL <<< "$SPEC"
  for DS in spider_dev bird_dev; do
    mkdir -p $OUT/$NAME.$DS; PIDS=()
    for i in $(seq 0 $((NGPU-1))); do
      CUDA_VISIBLE_DEVICES=$i $PY scripts/contract_intervention.py --model $MODEL --rollouts $ROLL \
        --data data/v1/$DS.parquet --ds $DS --out $OUT/$NAME.$DS/$DS.shard$i.jsonl \
        --samples ${SAMPLES:-4} --k ${K:-4} --shard $i/$NGPU $COMMON > $ROOT/logs/contract_int_$NAME.$DS.shard$i.$JOB_ID.log 2>&1 &
      PIDS+=($!)
    done
    for p in "${PIDS[@]}"; do wait $p || { echo "shard process $p failed ($NAME $DS)"; exit 1; }; done
  done
done

# stage 3: read-outs
$PY scripts/contract_intervention_analysis.py --out $OUT/readouts.json \
  --runs sftE3/spider=$OUT/sftE3.spider_dev sftE3/bird=$OUT/sftE3.bird_dev grpoE3/spider=$OUT/grpoE3.spider_dev grpoE3/bird=$OUT/grpoE3.bird_dev
if [ -n "${MAILTO:-}" ]; then
  { echo "contract intervention done ($JOB_ID)"; $PY -c "import json;d=json.load(open('$OUT/readouts.json'));[print(k, 'S_int', v.get('flip',{}).get('S_int'), v.get('flip',{}).get('ci95'), 'natural', v['natural_asymmetry'], 'remove', v.get('remove',{}).get('dP_submit_vs_orig'), 'acc', v['accuracy']) for k,v in d.items()]"; } \
    | mail -s "[AgenticRL_CV] contract intervention read-outs" "$MAILTO"
fi
echo INTERVENTION_DONE
