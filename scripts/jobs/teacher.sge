#!/bin/bash
#$ -q gpu
#$ -l gpu_card=4
#$ -pe smp 16
#$ -j y
#$ -o /path/to/Know2Act/logs/$JOB_NAME.$JOB_ID.log
# Teacher trajectories (Qwen3-32B, SkyRL recipe-mode stream) for SFT data; thinking is off (THINK=false, protocol v1).
# NSHARD data-parallel vLLM processes with TP GPUs each (NSHARD*TP <= granted GPUs).
# pilot: qsub -N teacher_pilot -l gpu_card=2 -v RUN=pilot,DATA=data/sft/pilot50.parquet,NSHARD=1,TP=2,N=2 scripts/jobs/teacher.sge
# full : qsub -N teacher_full -v RUN=full,NSHARD=2,TP=2,N=4 scripts/jobs/teacher.sge
set -euo pipefail
source /path/to/Know2Act/scripts/env.sh
export PYTHONHASHSEED=0
cd $ROOT
hostname; nvidia-smi --query-gpu=index,name,memory.used --format=csv,noheader
mkdir -p $LOCAL/omnisql && rsync -a $ROOT/data/omnisql/data/ $LOCAL/omnisql/data/
OUTD=$ROOT/results/teacher/$RUN; mkdir -p $OUTD
NSHARD=${NSHARD:-2}; TP=${TP:-2}
for i in $(seq 0 $((NSHARD-1))); do
  GPUS=$(seq -s, $((i*TP)) $((i*TP+TP-1)))
  CUDA_VISIBLE_DEVICES=$GPUS $PY scripts/rollout.py --data ${DATA:-data/v1/sft_pool.parquet} \
    --model $(snap Qwen/Qwen3-32B) --out $OUTD/shard$i.jsonl --db_path $LOCAL/omnisql/data \
    --n ${N:-4} --temperature 0.6 --top_p 0.95 --top_k 20 --tp $TP --shard $i/$NSHARD \
    --limit ${LIMIT:--1} --save_tokens --seed ${SEED:-0} --enable_thinking ${THINK:-false} --lenient \
    --max_generate_length ${MAX_GEN:-1024} --max_input_length ${MAX_INPUT:-8192} \
    > $ROOT/logs/teacher_$RUN.shard$i.$JOB_ID.log 2>&1 &
done
wait
echo TEACHER_DONE
