#!/bin/bash
#$ -q long
#$ -pe smp 8
#$ -j y
#$ -o /path/to/Know2Act/logs/$JOB_NAME.$JOB_ID.log
# CPU analyses for the manuscript (scripts/paper_analyses.py). PART=exec (RUNS="a b c") or PART=analyse.
set -euo pipefail
source /path/to/Know2Act/scripts/env.sh
cd $ROOT
if [ "$PART" = exec ]; then
  $PY scripts/paper_analyses.py --part exec --procs 8 --runs $(echo $RUNS | tr ':' ' ')
else
  $PY scripts/paper_analyses.py --part analyse
fi
echo PAPER_CPU_DONE
